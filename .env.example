# Leave unset for local development so Expo can infer your Mac's host address.
# Example for a hosted backend:
# EXPO_PUBLIC_API_URL=https://your-render-service.onrender.com
#
# AdMob banner ad unit for the top placement used on Home / Friends / Notifications / Settings.
# EXPO_PUBLIC_FRIENDSYNC_HOME_TOP_BANNER=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
#
# AdMob App IDs used by the native Google Mobile Ads SDK.
# GOOGLE_MOBILE_ADS_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
# GOOGLE_MOBILE_ADS_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
